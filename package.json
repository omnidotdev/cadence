{
  "name": "@omnidotdev/cadence",
  "version": "0.0.0",
  "type": "module",
  "description": "Headless calendar, date-grid, and iCalendar primitives for Omni scheduling surfaces",
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./ics": {
      "types": "./build/ics.d.ts",
      "import": "./build/ics.js"
    }
  },
  "files": [
    "build"
  ],
  "scripts": {
    "prepare": "husky",
    "build": "bun src/scripts/build.ts",
    "check": "biome check --diagnostic-level=error src",
    "clean": "rm -rf build node_modules",
    "dev": "bun build src/index.ts --outdir build --target browser --watch",
    "format": "biome format --write src",
    "knip": "knip-bun --cache --tags=-knipignore",
    "lint": "biome lint --write src",
    "test": "bun test",
    "typecheck": "bunx tsc"
  },
  "keywords": [
    "omni",
    "calendar",
    "scheduling",
    "icalendar",
    "typescript",
    "library"
  ],
  "license": "Apache-2.0",
  "homepage": "https://github.com/omnidotdev/cadence#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omnidotdev/cadence.git"
  },
  "bugs": "https://github.com/omnidotdev/cadence/issues",
  "author": "Omni <hey@omni.dev>",
  "packageManager": "bun@1.3.6",
  "dependencies": {
    "@internationalized/date": "^3.10.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.12",
    "husky": "^9.1.7",
    "@types/bun": "^1.3.6",
    "knip": "^5.82.1",
    "typescript": "^5.9.3"
  }
}
